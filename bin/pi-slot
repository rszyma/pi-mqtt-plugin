#!/usr/bin/env bash
# pi-slot — claim a stable agent slot on the HOST and run a command with it.
#
# The guest VM never touches a lock: the launcher claims a slot on the host
# filesystem (plain ext4/tmpfs, no qemu-share semantics involved) and passes
# the won suffix into the VM as PI_AGENT_MQTT_INSTANCE_SUFFIX. Locks live in
# host processes, so PC sleep never frees them; killing the VM kills the
# holder and frees the slot. MQTT presence (LWT offline) is only a reporting
# signal for Home Assistant, never the allocator.
#
# Usage:
#   pi-slot [--slots N] [--dir DIR] [--holder NAME] [--on-overflow fail|wait] -- <command...>
#   pi-slot --claim [...]            # print suffix and hold until killed (for wrappers)
#   pi-slot --list                   # show slot table and exit
#
# Env overrides: PI_AGENT_MQTT_SLOT_COUNT, PI_AGENT_MQTT_SLOT_DIR, PI_AGENT_MQTT_HOLDER
set -euo pipefail

SLOTS="${PI_AGENT_MQTT_SLOT_COUNT:-4}"
SLOT_DIR="${PI_AGENT_MQTT_SLOT_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/pi-slots}"
HOLDER="${PI_AGENT_MQTT_HOLDER:-}"
ON_OVERFLOW="fail"
MODE="run"
POLL_INTERVAL=5

usage() {
  cat <<EOF
Usage: pi-slot [options] -- <command...>

Options:
  --slots N            Pool size (default: \$PI_AGENT_MQTT_SLOT_COUNT or 4)
  --dir DIR            Lock dir on host fs (default: \$PI_AGENT_MQTT_SLOT_DIR or ~/.cache/pi-slots)
  --holder NAME        Label recorded in the slot file (default: \$PI_AGENT_MQTT_HOLDER)
  --on-overflow MODE   fail (default) or wait (block until a slot frees)
  --claim              Claim a slot, print its number, hold until killed
  --list               Print slot table and exit
  -h, --help           This help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --slots) SLOTS="$2"; shift 2 ;;
    --dir) SLOT_DIR="$2"; shift 2 ;;
    --holder) HOLDER="$2"; shift 2 ;;
    --on-overflow) ON_OVERFLOW="$2"; shift 2 ;;
    --claim) MODE="claim"; shift ;;
    --list) MODE="list"; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) echo "pi-slot: unknown option $1" >&2; usage >&2; exit 2 ;;
  esac
done

if ! [[ "$SLOTS" =~ ^[0-9]+$ ]] || [[ "$SLOTS" -lt 1 ]]; then
  echo "pi-slot: --slots must be a positive integer (got '$SLOTS')" >&2
  exit 2
fi
if [[ "$ON_OVERFLOW" != "fail" && "$ON_OVERFLOW" != "wait" ]]; then
  echo "pi-slot: --on-overflow must be fail or wait (got '$ON_OVERFLOW')" >&2
  exit 2
fi

mkdir -p "$SLOT_DIR"

slot_pid() {
  local f="$1"
  [[ -f "$f" ]] || return 1
  local pid
  pid="$(cut -d' ' -f1 < "$f" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

# Try to claim slot N atomically via mkdir (atomic on POSIX). Returns 0 on win.
try_claim() {
  local n="$1" lock="$SLOT_DIR/slot-$n"
  if mkdir "$lock" 2>/dev/null; then
    echo "$$ ${HOLDER:-} $(date -u +%FT%TZ)" > "$lock/owner"
    echo "$n"
    return 0
  fi
  # Stale holder (dead pid)? Remove and retry once.
  if [[ -f "$lock/owner" ]] && ! slot_pid "$lock/owner"; then
    rm -rf "$lock" 2>/dev/null || true
    if mkdir "$lock" 2>/dev/null; then
      echo "$$ ${HOLDER:-} $(date -u +%FT%TZ)" > "$lock/owner"
      echo "$n"
      return 0
    fi
  fi
  return 1
}

find_free_slot() {
  local n claimed
  for (( n = 1; n <= SLOTS; n++ )); do
    if claimed="$(try_claim "$n")"; then
      echo "$claimed"
      return 0
    fi
  done
  return 1
}

list_slots() {
  local n lock owner pid rest
  for (( n = 1; n <= SLOTS; n++ )); do
    lock="$SLOT_DIR/slot-$n"
    if [[ -f "$lock/owner" ]]; then
      owner="$(cat "$lock/owner" 2>/dev/null || true)"
      pid="$(echo "$owner" | cut -d' ' -f1)"
      rest="$(echo "$owner" | cut -d' ' -f2-)"
      if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        echo "slot-$n: BUSY pid=$pid ${rest:-}"
      else
        echo "slot-$n: STALE ${rest:-}"
      fi
    else
      echo "slot-$n: FREE"
    fi
  done
}

release_slot() {
  local n="$1"
  # Only remove our own claim (pid match) — never steal on exit.
  if [[ -f "$SLOT_DIR/slot-$n/owner" ]]; then
    local owner_pid
    owner_pid="$(cut -d' ' -f1 < "$SLOT_DIR/slot-$n/owner" 2>/dev/null || true)"
    if [[ "$owner_pid" == "$$" ]]; then
      rm -rf "$SLOT_DIR/slot-$n"
    fi
  fi
}

if [[ "$MODE" == "list" ]]; then
  list_slots
  exit 0
fi

claim_one() {
  local claimed=""
  while true; do
    if claimed="$(find_free_slot)"; then
      echo "$claimed"
      return 0
    fi
    if [[ "$ON_OVERFLOW" == "fail" ]]; then
      return 1
    fi
    sleep "$POLL_INTERVAL"
  done
}

if [[ "$MODE" == "claim" ]]; then
  if ! SLOT="$(claim_one)"; then
    echo "pi-slot: no free slot (pool size $SLOTS)" >&2
    exit 3
  fi
  trap "release_slot '$SLOT'" EXIT INT TERM
  echo "$SLOT"
  # Hold the claim until killed.
  while true; do sleep 86400 & wait $!; done
fi

# MODE == run
if [[ $# -eq 0 ]]; then
  echo "pi-slot: no command given (usage: pi-slot -- <command...>)" >&2
  exit 2
fi
if ! SLOT="$(claim_one)"; then
  echo "pi-slot: no free slot (pool size $SLOTS) — refusing to start $*" >&2
  exit 3
fi
trap "release_slot '$SLOT'" EXIT INT TERM
export PI_AGENT_MQTT_INSTANCE_SUFFIX="$SLOT"
if [[ -n "$HOLDER" ]]; then
  export PI_AGENT_MQTT_HOLDER="$HOLDER"
fi
exec "$@"
